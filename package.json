    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "gh-pages": "6.1.1",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ashlynbloomfield24/DISC-LAB.git"
  },
  "homepage": "https://ashlynbloomfield24.github.io/DISC-LAB/"
